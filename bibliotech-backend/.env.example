# Configuração da Aplicação
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo

# Banco de Dados MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=biblioteca
DB_USER=seu_usuario
DB_PASS=sua_senha_segura

# Chaves Criptográficas (AES-256) — gere chaves aleatórias de 64 e 32 hex
APP_KEY=gere_uma_chave_hexadecimal_de_64_caracteres
APP_IV=gere_um_iv_hexadecimal_de_32_caracteres

# Logs
LOG_LEVEL=INFO
LOG_CHANNEL=file
