# Configuração da Aplicação
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo

# Banco de Dados MySQL (XAMPP padrão: usuário root e senha vazia)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=biblioteca
DB_USER=root
DB_PASS=

# Chaves Criptográficas (AES-256-CBC: 64 caracteres hex para APP_KEY e 32 hex para APP_IV)
# Os valores abaixo são compatíveis com os dados iniciais do Banco_de_dados_v1.1.sql.
# Em produção real, substitua por chaves hexadecimais aleatórias exclusivas do servidor.
APP_KEY=e3aae9c1dac832d504c067c5642442ef730094bfe80bade9d742b7a890f46772
APP_IV=8bbc0ae95ea41dff43ee6fca2036ee09

# Logs
LOG_LEVEL=INFO
LOG_CHANNEL=file
